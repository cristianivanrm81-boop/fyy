# ── REQUIRED ────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
ALLOWED_GUILD_IDS=123456789,987654321
ALLOWED_USERS=111111111,222222222       # Discord IDs with full admin access

# ── ROLE GATING (optional) ──────────────────────────────────────────────────
# Role IDs that can use public commands (/token, /mystats, /leaderboard etc).
# Leave empty to allow all server members to use public commands.
ALLOWED_ROLES=

# ── NAKAMA ──────────────────────────────────────────────────────────────────
NAKAMA_HOST=https://animalcompany.us-east1.nakamacloud.io
NAKAMA_SERVER_KEY=6URuTSlDKKfYbuDW

# ── BEHAVIOR ────────────────────────────────────────────────────────────────
COOLDOWN_SECONDS=0          # 0 = no cooldown between /token requests

# The refresh loop fires every 25 minutes (hardcoded).
# TOKEN_REFRESH_THRESHOLD controls when a session is considered "needs refresh":
# default 1560s (26 min) — slightly above the 25-min loop interval so a token
# expiring on the next tick is always caught on the current one.
# Sessions are refreshed ONE AT A TIME with a 2s gap between HTTP calls.
TOKEN_REFRESH_THRESHOLD=1560

# ── DATA FILES ──────────────────────────────────────────────────────────────
TOKENS_FILE=tokens.json
COOLDOWNS_FILE=cooldowns.json
STATS_FILE=stats.json
CHANNELS_FILE=channels.json

# ── ALERTS ──────────────────────────────────────────────────────────────────
# Channel ID to send burn alerts to. 0 = DM to each admin in ALLOWED_USERS.
BURN_ALERT_CHANNEL=0

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
